---
interface Props { kind: 'trading' | 'voice' }
const { kind } = Astro.props;
const candles = [
  [30, 22, 0], [42, 17, 0], [51, 19, 0], [44, 15, 1], [36, 22, 1], [47, 18, 0],
  [56, 24, 0], [68, 24, 0], [56, 14, 1], [65, 18, 0], [72, 25, 0], [65, 16, 1],
  [76, 19, 0], [80, 18, 0],
];
const voice = [11, 15, 25, 17, 31, 58, 84, 53, 24, 17, 30, 64, 93, 72, 36, 19, 26, 45, 30, 19, 12];
---
<div class:list={['case-visual', `case-visual--${kind}`]} aria-hidden="true">
  <div class="visual-caption mono">
    <span>{kind === 'trading' ? 'TRADING WORKFLOW' : 'VOICE RESPONSE'}</span>
    <span>{kind === 'trading' ? 'E2E' : 'ES / PT'}</span>
  </div>
  {kind === 'trading' ? (
    <div class="market-chart">
      {candles.map(([level, range, down]) => (
        <i class:list={['candle', { 'candle-down': down }]} style={`--level:${level}%;--range:${range}%`}></i>
      ))}
    </div>
  ) : (
    <div class="voice-chart">
      <div class="voice-rings"></div>
      <div class="voice-bars">
        {voice.map((height) => <i style={`--amplitude:${height}%`}></i>)}
      </div>
    </div>
  )}
  <div class="visual-footer mono">Illustration</div>
</div>
